generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model activities {
  id                                 String             @id @db.VarChar(50)
  title                              String             @db.VarChar(200)
  start_date                         DateTime?          @db.DateTime(0)
  end_date                           DateTime?          @db.DateTime(0)
  og_title                           String?            @db.VarChar(200)
  og_description                     String?            @db.Text
  og_image                           String?            @db.VarChar(500)
  sort_order                         Int?               @default(0) @db.UnsignedInt
  created_by                         Int?               @db.UnsignedInt
  updated_by                         Int?               @db.UnsignedInt
  created_at                         DateTime?          @default(now()) @db.DateTime(0)
  updated_at                         DateTime?          @default(now()) @db.DateTime(0)
  users_activities_created_byTousers users?             @relation("activities_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction, map: "activities_ibfk_1")
  users_activities_updated_byTousers users?             @relation("activities_updated_byTousers", fields: [updated_by], references: [id], onUpdate: NoAction, map: "activities_ibfk_2")
  activity_content                   activity_content[]
  activity_tags                      activity_tags[]
  activity_views                     activity_views[]

  @@index([created_by], map: "created_by")
  @@index([updated_by], map: "updated_by")
}

model activity_content {
  id                Int                   @id @default(autoincrement()) @db.UnsignedInt
  activity_id       String                @db.VarChar(50)
  type              activity_content_type
  file              String?               @db.VarChar(255)
  video_id          String?               @db.VarChar(50)
  sort_order        Int?                  @default(0) @db.UnsignedInt
  activities        activities            @relation(fields: [activity_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "activity_content_ibfk_1")
  activity_hotspots activity_hotspots[]

  @@index([activity_id], map: "activity_id")
}

model activity_hotspots {
  id                  String           @id @db.VarChar(50)
  activity_content_id Int              @db.UnsignedInt
  x                   Decimal          @db.Decimal(10, 6)
  y                   Decimal          @db.Decimal(10, 6)
  width               Decimal          @db.Decimal(10, 6)
  height              Decimal          @db.Decimal(10, 6)
  url                 String?          @db.VarChar(500)
  activity_content    activity_content @relation(fields: [activity_content_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "activity_hotspots_ibfk_1")

  @@index([activity_content_id], map: "activity_content_id")
}

model activity_tags {
  activity_id String     @db.VarChar(50)
