# Server
PORT=4000
ORIGIN=                          # 前端網域，例：https://dmpage.chungyo.com.tw
FRONTEND_DIST_PATH=              # 前端打包路徑（選填，預設 ../html）
FRONTEND_HTML_PATH=              # SPA HTML 路徑（選填）

# SendGrid 寄信
SENDGRID_API_KEY=                # SendGrid API Key
MAIL_SEND_FROM=                  # 寄件者 email
MAIL_SEND_TO=                    # 收件者 email
MAIL_SEND_SUBJECT=系統通知：顧客意見回饋
MAIL_SEND_TEXT=已收到新的顧客意見回饋，請至後台確認。

# 外部 API
API_URL=                         # 員工班表 API

# Database（Prisma）
# 格式：mysql://USER:PASSWORD@HOST:PORT/DATABASE
# 特殊字元需 URL encode，例：! → %21
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/chungyoOffical"
